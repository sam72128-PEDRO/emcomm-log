{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMCOMM LOG",
  "version": "1.0.0",
  "identifier": "org.emcommlog.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EMCOMM LOG",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Offline emergency communications logbook",
    "longDescription": "EMCOMM LOG is an offline, single-user desktop communications log for routine, amateur radio, and emergency operations.",
    "copyright": "EMCOMM LOG",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": [] } }
  }
}
